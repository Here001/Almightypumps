# --- Database (PostgreSQL 14+). Neon, Supabase or Railway all work. ---
DATABASE_URL=postgres://user:password@localhost:5432/almighty_pumps
# Set to true for hosted databases that require SSL (Neon, Supabase).
DATABASE_SSL=false

# --- App ---
APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CRON_SECRET=change-me-to-another-long-random-string

# --- Flutterwave (app.flutterwave.com > Settings > API Keys / Webhooks) ---
# Secret key: FLWSECK_TEST-... for test mode, FLWSECK-... for live.
FLUTTERWAVE_SECRET_KEY=paste-your-flutterwave-secret-key-here
# Webhook URL to set in Flutterwave: {APP_URL}/api/webhooks/flutterwave
# Use the same random value here and in the dashboard's "Secret hash" box.
FLUTTERWAVE_WEBHOOK_HASH=change-me-to-a-long-random-string

# --- Limits (kobo) ---
MIN_FUNDING_KOBO=100000
MIN_WITHDRAWAL_KOBO=200000

# --- Social growth providers ---
# Each provider row in the database names the env var that holds its API key.
# Example for the provider created by `npm run db:seed`:
SMM_PROVIDER_1_KEY=your-provider-api-key

# --- Seed: first admin account ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong-password
